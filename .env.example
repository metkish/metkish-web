# Public Mapbox access token used by the scroll-driven journey map on
# destination pages (see components/journey/JourneyMapScene.tsx). Get a
# free token at https://account.mapbox.com/access-tokens/ and set it both
# locally (in .env.local, which is gitignored) and in the Vercel project
# settings (Development, Preview and Production environments).
NEXT_PUBLIC_MAPBOX_TOKEN=
